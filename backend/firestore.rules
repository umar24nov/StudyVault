rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Papers ────────────────────────────────────────
    // Public reads approved papers. All writes happen server-side via the
    // Firebase Admin SDK (which bypasses rules), so client writes are denied.
    match /papers/{paperId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create, update, delete: if false;
    }

    // ── Users ─────────────────────────────────────────
    // Users can read/write their own doc only. Admins can read all.
    // Profile fields are managed by the server; clients may only touch
    // their own doc, not arbitrary fields.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'picture']);
      allow update: if request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name', 'picture']);
      allow delete: if isAdmin();
    }

    // ── Bookmarks ─────────────────────────────────────
    // Users manage only their own bookmarks.
    match /bookmarks/{bookmarkId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── Reviews ───────────────────────────────────────
    // Public reads approved. Creation happens server-side (Admin SDK),
    // so client creates are denied to enforce moderation + rate limits.
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create, update, delete: if false;
    }

    // ── Feedback ──────────────────────────────────────
    // Created server-side only (rate-limited).
    match /feedback/{entry} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    // ── Contacts ──────────────────────────────────────
    // Created server-side only (rate-limited + validated).
    match /contacts/{entry} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ── Admins ────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
