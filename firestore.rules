rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Papers ────────────────────────────────────────
    // Public reads approved papers. Only server (via Firebase Admin SDK) writes.
    match /papers/{paperId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isSignedIn();  // enforced server-side by verifyToken
      allow update, delete: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────
    // Users can read/write their own doc only. Admins can read all.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ── Bookmarks ─────────────────────────────────────
    match /bookmarks/{bookmarkId} {
      allow read, write: if isSignedIn();
    }

    // ── Reviews ───────────────────────────────────────
    // Public reads approved. Users can create. Admins manage all.
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Feedback ──────────────────────────────────────
    match /feedback/{entry} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Contacts ──────────────────────────────────────
    match /contacts/{entry} {
      allow create: if true;  // anyone can contact
      allow read, update, delete: if isAdmin();
    }

    // ── Admins ────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
